# Copy to .env for local overrides (.env is git-ignored). Never commit real credentials.

# --- Profile ---
# dev  = in-memory H2, no setup (default when running ./mvnw spring-boot:run)
# prod = PostgreSQL + Flyway (used by docker compose and Render)
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# --- PostgreSQL (prod profile) ---
# Either set DB_URL to a full JDBC URL, or the parts below.
# DB_URL=jdbc:postgresql://localhost:5432/orders
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orders
DB_USER=orders
DB_PASSWORD=change-me

# --- HikariCP connection pool ---
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_MAX_LIFETIME_MS=1200000
DB_POOL_LEAK_DETECTION_MS=0

# --- App ---
# Insert 5 demo orders on startup if the table is empty
SEED_DEMO_DATA=true
# Actuator endpoints exposed over HTTP, and whether /actuator/health shows component details
MANAGEMENT_ENDPOINTS=health,info,prometheus,metrics
HEALTH_SHOW_DETAILS=never

# --- docker compose only: host ports ---
API_HOST_PORT=8080
DB_HOST_PORT=5433
